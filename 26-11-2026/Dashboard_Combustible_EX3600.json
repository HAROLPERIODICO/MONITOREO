     "sort": "desc"
    }
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "medicion",
    "label": "Modelo",
    "type": "custom",
    "query": "EX3600-6 : HCM_EX3600-6_EX-6,EX3600-7 : HCM_EX3600-7-CMS_EX-7-CMS-L-ENDIAN",
    "current": {
     "text": "EX3600-6",
     "value": "HCM_EX3600-6_EX-6"
    },
    "options": [
     {
      "text": "EX3600-6",
      "value": "HCM_EX3600-6_EX-6",
      "selected": true
     },
     {
      "text": "EX3600-7",
      "value": "HCM_EX3600-7-CMS_EX-7-CMS-L-ENDIAN",
      "selected": false
     }
    ]
   },
   {
    "name": "equipo",
    "label": "Equipo",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "${DS_READYLINE}"
    },
    "query": "SHOW TAG VALUES FROM \"$medicion\" WITH KEY = \"equip_id\"",
    "definition": "SHOW TAG VALUES FROM \"$medicion\" WITH KEY = \"equip_id\"",
    "refresh": 1,
    "multi": true,
    "includeAll": true,
    "regex": "/^I\\d+$/",
    "sort": 3,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
