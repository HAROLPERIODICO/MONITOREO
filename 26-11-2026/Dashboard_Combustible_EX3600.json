    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "RPM del motor (contexto: si la pala está detenida o en parada, la boya no se mueve)",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_READYLINE}"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 7
   },
   "interval": "30s",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_READYLINE}"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT mean(\"Engine Speed of Left Engine\") FROM /^(HCM_EX3600-6_EX-6|HCM_EX-7-J1939_EX-7-L-ENDIAN)$/ WHERE \"equip_id\" =~ /^$equipo$/ AND $timeFilter AND \"Engine Speed of Left Engine\" < 2500 GROUP BY time($__interval), \"equip_id\" fill(none)",
     "alias": "$tag_equip_id"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "rotrpm",
     "decimals": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": 600000,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "lineInterpolation": "linear"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 800
       },
       {
        "color": "green",
        "value": 1600
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "min",
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
