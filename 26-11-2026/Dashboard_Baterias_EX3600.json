{
 "__inputs": [
  {
   "name": "DS_READYLINE",
   "label": "ReadyLine (InfluxDB)",
   "description": "Seleccione readyline",
   "type": "datasource",
   "pluginId": "influxdb",
   "pluginName": "InfluxDB"
  }
 ],
 "__requires": [
  {
   "type": "datasource",
   "id": "influxdb",
   "name": "InfluxDB",
   "version": "1.0.0"
  },
  {
   "type": "panel",
   "id": "table",
   "name": "Table",
   "version": ""
  },
  {
   "type": "panel",
   "id": "timeseries",
   "name": "Time series",
   "version": ""
  }
 ],
 "title": "Monitoreo · Baterías EX3600",
 "uid": "baterias-ex3600",
 "tags": [
  "readyline",
  "EX3600",
  "baterias"
 ],
 "timezone": "browser",
 "schemaVersion": 36,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Estado de baterías por pala (semáforo)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "table",
   "title": "Semáforo · voltaje de baterías en el periodo (V) — con motor operando debe estar ≈27 V",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_READYLINE}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 10
   },
   "interval": "10s",
   "description": "Mediana ≈ voltaje de carga (la pala pasa casi todo el tiempo con motor encendido). Mediana < 25 V: el banco no está recibiendo carga del alternador. Mínimo bajo incluye caídas de arranque, que son normales si son breves.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_READYLINE}"
     },
     "rawQuery": true,
     "resultFormat": "table",
     "query": "SELECT last(\"Battery voltage\") AS \"Último\", median(\"Battery voltage\") AS \"Mediana\", percentile(\"Battery voltage\", 5) AS \"p5\", min(\"Battery voltage\") AS \"Mínimo\", max(\"Battery voltage\") AS \"Máximo\" FROM \"$medicion\" WHERE \"equip_id\" =~ /^$equipo$/ AND $timeFilter AND \"Battery voltage\" < 40 GROUP BY \"equip_id\""
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "equip_id": "Equipo"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Mediana"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 24
       },
       {
        "color": "#FADE2A",
        "value": 25
       },
       {
        "color": "green",
        "value": 26
       }
      ]
     },
     "custom": {
      "align": "center",
      "cellOptions": {
       "type": "color-background"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Equipo"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Máximo"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 3,
   "type": "row",
   "title": "Voltaje por pala (una gráfica por equipo seleccionado)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Baterías · $equipo",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_READYLINE}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "interval": "10s",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_READYLINE}"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT mean(\"Battery voltage\") AS \"Voltaje\" FROM \"$medicion\" WHERE \"equip_id\" = '$equipo' AND \"Battery voltage\" < 40 AND $timeFilter GROUP BY time($__interval) fill(null)",
     "alias": "$col"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "decimals": 1,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": false,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 24
       },
       {
        "color": "#FADE2A",
        "value": 25
       },
       {
        "color": "green",
        "value": 26
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 20,
     "max": 29
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "min",
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "repeat": "equipo",
   "repeatDirection": "h",
   "maxPerRow": 3
  },
  {
   "id": 5,
   "type": "row",
   "title": "Comparación entre palas",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Voltaje de baterías · comparación entre equipos",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_READYLINE}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 9
   },
   "interval": "10s",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_READYLINE}"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT mean(\"Battery voltage\") FROM \"$medicion\" WHERE \"equip_id\" =~ /^$equipo$/ AND $timeFilter AND \"Battery voltage\" < 40 GROUP BY time($__interval), \"equip_id\" fill(null)",
     "alias": "$tag_equip_id"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "decimals": 1,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": false,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 24
       },
       {
        "color": "#FADE2A",
        "value": 25
       },
       {
        "color": "green",
        "value": 26
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 20,
     "max": 29
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "min",
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "RPM del motor (contexto: ≥1600 rpm debe cargar ≈27 V; <800 rpm reposo 24–25 V)",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_READYLINE}"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 7
   },
   "interval": "10s",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_READYLINE}"
     },
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT mean(\"Engine Speed of Left Engine\") FROM /^(HCM_EX3600-6_EX-6|HCM_EX-7-J1939_EX-7-L-ENDIAN)$/ WHERE \"equip_id\" =~ /^$equipo$/ AND $timeFilter AND \"Engine Speed of Left Engine\" < 2500 GROUP BY time($__interval), \"equip_id\" fill(null)",
     "alias": "$tag_equip_id"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "rotrpm",
     "decimals": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": false,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 800
       },
       {
        "color": "green",
        "value": 1600
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "min",
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "medicion",
    "label": "Modelo",
    "type": "custom",
    "query": "EX3600-6 : HCM_EX3600-6_EX-6,EX3600-7 : HCM_EX3600-7-CMS_EX-7-CMS-L-ENDIAN",
    "current": {
     "text": "EX3600-6",
     "value": "HCM_EX3600-6_EX-6"
    },
    "options": [
     {
      "text": "EX3600-6",
      "value": "HCM_EX3600-6_EX-6",
      "selected": true
     },
     {
      "text": "EX3600-7",
      "value": "HCM_EX3600-7-CMS_EX-7-CMS-L-ENDIAN",
      "selected": false
     }
    ]
   },
   {
    "name": "equipo",
    "label": "Equipo",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "${DS_READYLINE}"
    },
    "query": "SHOW TAG VALUES FROM \"$medicion\" WITH KEY = \"equip_id\"",
    "definition": "SHOW TAG VALUES FROM \"$medicion\" WITH KEY = \"equip_id\"",
    "refresh": 1,
    "multi": true,
    "includeAll": true,
    "regex": "/^I\\d+$/",
    "sort": 3,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": []
 }
}